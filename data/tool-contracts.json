    {
      "name": "calculate_metrics",
      "validation": "agents/tools.py",
      "implementation": "agents/tools_impl.calculate_metrics → agents/calculator.execute_calculation",
      "roles": [
        "researcher",
        "reviewer"
      ],
      "input": {
        "operation": {
          "type": "string",
          "enum": [
            "growth_rate",
            "simple_return",
            "pe_ttm",
            "dcf_scenario",
            "peer_comparison"
          ],
          "required": true
        },
        "values": {
          "type": "object",
          "required": true
        },
        "evidence_refs": {
          "type": "array",
          "max_items": 20,
          "required": true,
          "rule": "不可為空陣列"
        }
      },
      "operations": {
        "growth_rate": {
          "values": [
            "current",
            "previous"
          ],
          "rule": "任一缺或前期 ≤ 0 → invalid_input（基期為負或 0 時成長率無意義，回 NA）"
        },
        "simple_return": {
          "values": [
            "entry_price",
            "exit_price"
          ],
          "rule": "買價缺或非正 → invalid_input"
        },
        "pe_ttm": {
          "values": [
            "price",
            "eps_ttm"
          ],
          "rule": "同日未還原收盤價 ÷ TTM EPS；EPS ≤ 0 或缺 → invalid_input"
        },
        "dcf_scenario": {
          "values": [
            "free_cash_flows（5 年，億元）",
            "wacc",
            "terminal_growth",
            "net_debt（億元）",
            "shares_outstanding（百萬股）"
          ],
          "rule": "任一缺 → invalid_input；非 5 年 → invalid_input；WACC ≤ g → invalid_input；股數 ≤ 0 → invalid_input",
          "output": [
            "pv_fcf_total",
            "terminal_value",
            "pv_terminal",
            "enterprise_value",
            "equity_value",
            "intrinsic_value_per_share",
            "sensitivity_matrix（WACC ±1%、g ±0.5%；WACC ≤ g 格為 null）"
          ],
          "pending": [
            "WACC 10%、g 3% 為程式預設值，待組長核定"
          ]
        },
        "peer_comparison": {
          "values": [
            "subject=2454",
            "comparators ⊂ {2379,3034,2330}",
            "metrics{ticker:{price,eps_ttm,bvps,pb,revenue_yoy,fcf,dcf_per_share}}",
            "price_as_of（YYYY-MM-DD）",
            "cutoff",
            "snapshot_ids{ticker:id}",
            "method_version"
          ],
          "rule": "最多 4 家含主體；2330 為 industry_reference，不入同業平均；BVPS ≤ 0 → pb 為 null 並附理由",
          "output": [
            "comparison_table",
            "peer_average_stats"
          ]
        }
      },
      "errors": {
        "invalid_input": "evidence_refs 為空、operation 不在五項、運算條件不滿足"
      },
