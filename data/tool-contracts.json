          "required": true
        },
        "query": {
          "type": "string",
          "max_length": 200,
          "required": true
        },
        "cutoff": {
          "type": "string",
          "format": "ISO-8601，必含時區",
          "required": true,
          "rule": "不得晚於 job.cutoff_at"
        },
        "limit": {
          "type": "integer",
          "min": 1,
          "max": 5,
          "required": true
        }
      },
      "data": "array（最多 limit 筆）",
      "data_fields": [
        "source_id",
        "content_hash",
        "available_at",
        "available_at_basis",
        "evidence_version_id",
        "ticker",
        "title",
        "published_at",
        "captured_at",
        "abstract"
      ],
      "errors": {
        "invalid_input": "ticker 不在三檔、query 超長或含 URL/SQL、cutoff 缺時區或晚於 job cutoff",
